# RentFlow Backend — Environment Variables
# Copy to .env and fill in values before running

# ─── App ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

# ─── JWT ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_HEX
# Access token lifetime — keep short (default 15m). Refresh tokens handle session continuity.
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime — stored as httpOnly cookie + SHA-256 hash in DB.
JWT_REFRESH_EXPIRES_IN=30d

# ─── MongoDB ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/rentflow
# Production: mongodb://rentflow_app:PASSWORD@127.0.0.1:27017/rentflow?authSource=rentflow

# ─── File Storage ─────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
UPLOAD_BASE_URL=http://localhost:3001/uploads

# ─── Receipt Storage ──────────────────────────────────────
RECEIPT_STORAGE_DIR=./uploads/receipts
RECEIPT_BASE_URL=http://localhost:3001/receipts

# ─── Email (SMTP) ─────────────────────────────────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@rentflow.com

# ─── DigiLocker ───────────────────────────────────────────
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:3001/api/v1/digilocker/callback

# ─── Encryption ───────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX
AADHAAR_SALT=REPLACE_WITH_32_BYTE_HEX

# ─── Security ─────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=60
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs

# ─── Subscription ─────────────────────────────────────────
SUBSCRIPTION_TRIAL_DAYS=14
