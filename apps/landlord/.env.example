# Landlord App — Environment Variables
# Copy to .env.local for development

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_WEB_URL=http://localhost:3005
NEXT_PUBLIC_TENANT_URL=http://localhost:3004

# Used by Next.js middleware (Edge Runtime) to verify JWT
JWT_ACCESS_SECRET=REPLACE_WITH_SAME_SECRET_AS_BACKEND
